{
  "manifest_version": 3,
  "name": "Fetchlane",
  "version": "0.1.1",
  "description": "Send downloads and magnet links from your browser to the Fetchlane download manager.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "contextMenus", "nativeMessaging", "storage", "activeTab"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Fetchlane",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
